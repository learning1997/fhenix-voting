# Deployer key. Used by the CoFHE hardhat plugin for the eth-sepolia / arb-sepolia networks.
# NEVER commit a real key.
PRIVATE_KEY= 

# Optional RPC overrides (public RPCs are used otherwise)
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Optional contract verification
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# Frontend (frontend/.env) - the deployed PrivateVoting address
VITE_CONTRACT_ADDRESS=
